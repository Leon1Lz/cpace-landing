# ==========================================
# CPACE Philippines Landing App Environment
# ==========================================

# --- External Links ---
# Optional: Learning Portal URL (defaults to https://certifications.cpaceph.com/login)
NEXT_PUBLIC_LMS_URL=https://certifications.cpaceph.com/login

# Optional: Registration URL (defaults to https://linktr.ee/cpaceph)
NEXT_PUBLIC_REGISTER_URL=https://linktr.ee/cpaceph

# --- Real Email Sending (SMTP / Gmail / Google Workspace / Custom Mail Server) ---
# For Gmail / Google Workspace:
# 1. Enable 2-Step Verification on your Google Account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use smtp.gmail.com with port 465 (secure) or 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cpaceph.com
SMTP_PASS=your-16-character-app-password
# SMTP_PASSWORD is also accepted when SMTP_PASS is unset.

# Email destination for new website inquiries (defaults to info@cpaceph.com)
CONTACT_EMAIL_TO=info@cpaceph.com
CONTACT_EMAIL_FROM="CPACE Inquiries" <info@cpaceph.com>

# Optional: Send automatic confirmation email to the applicant (true / false)
SEND_AUTO_REPLY=true

